# Server-side only — tidak terekspos ke client bundle
API_URL=http://localhost:3008/api

# Client-side — untuk fetch dari Client Components (like, comment)
NEXT_PUBLIC_API_URL=http://localhost:3008/api

# ── Google AdSense ─────────────────────────────────────────────────────────
# Isi setelah akun AdSense disetujui Google.
# Panduan: https://support.google.com/adsense/answer/7459871

# Publisher ID — format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_PUB_ID=ca-pub-XXXXXXXXXXXXXXXX

# Slot ID tiap posisi iklan (buat di: AdSense → Iklan → Per unit)
NEXT_PUBLIC_AD_SLOT_BILLBOARD=
NEXT_PUBLIC_AD_SLOT_MEDIUM_RECT=
NEXT_PUBLIC_AD_SLOT_INFEED=
NEXT_PUBLIC_AD_SLOT_ARTICLE_MID=
NEXT_PUBLIC_AD_SLOT_STICKY=